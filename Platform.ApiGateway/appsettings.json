{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "orders": {
        "ClusterId": "orders",
        "Order": 10,
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "orders", "Version": "v1" }
      },
      "customers": {
        "ClusterId": "orders",
        "Order": 10,
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "orders", "Version": "v1" }
      },
      "products": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/products/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "categories": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "reviews", "Version": "v1" }
      },
      "discussions": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/discussions/{**catch-all}" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "orders": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://orders-api" } }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://catalog-api" } }
      },
      "reviews": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  }
}
