{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "cosmetics-auth",
    "Audience": "cosmetics-platform",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "PublicBaseUrl": "http://localhost:5000",
    "ExposeRefreshTokenInBody": false
  },
  "Seed": {
    "Enabled": true,
    "AdminEmail": "admin@cosmetics.local",
    "UserEmail": "olena@cosmetics.local"
  }
}
